; Engine configuration file.
; Ashes of Humanity: Last Signal — Godot 4.7 project
config_version=5

[application]

config/name="Ashes of Humanity: Last Signal"
config/description="Next-generation 3D post-apocalyptic open-world survival action RPG"
run/main_scene="res://scenes/Boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/branding/icon.png"
boot_splash/image="res://assets/branding/loading.png"
boot_splash/bg_color=Color(0.035, 0.038, 0.04, 1)
boot_splash/use_filter=true
config/macos_native_icon="res://assets/branding/icon.png"
config/windows_native_icon="res://assets/branding/icon.png"

[autoload]

GameState="*res://src/autoload/game_state.gd"
SettingsStore="*res://src/autoload/settings_store.gd"
ItemDB="*res://src/autoload/item_db.gd"
WorldClock="*res://src/autoload/world_clock.gd"
Weather="*res://src/autoload/weather.gd"
AudioMan="*res://src/autoload/audio_manager.gd"
QuestDB="*res://src/autoload/quest_db.gd"
QuestMan="*res://src/autoload/quest_manager.gd"
SaveMan="*res://src/autoload/save_manager.gd"
EventMan="*res://src/autoload/event_manager.gd"
UIRouter="*res://src/autoload/ui_router.gd"

[display]

window/size/title="Ashes of Humanity: Last Signal"
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/positional_shadow/atlas_size=2048
environment/defaults/default_clear_color=Color(0.05, 0.06, 0.07, 1)
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=1

[physics]

3d/physics_engine="GodotPhysics3D"
common/physics_ticks_per_second=60

[input_devices]

pointing/emulate_touch_from_mouse=false

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="enemy"
3d_physics/layer_4="loot"
3d_physics/layer_5="building"
3d_physics/layer_6="raycast"
