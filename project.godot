; Engine configuration for DON'T LOOK BACK
; Copyright (c) 2026
config_version=5

[application]
config/name="DON'T LOOK BACK"
config/description="A first-person psychological horror anomaly-detection game"
config/icon="res://assets/icon.png"
config/windows_native_icon="res://assets/icon.ico"
run/main_scene="res://scenes/game.tscn"
boot_splash/image="res://assets/loading_splash.png"
boot_splash/fullsize=true
boot_splash/bg_color=Color(0.012, 0.016, 0.018, 1)
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.012, 0.016, 0.021, 1)

[physics]
3d/default_gravity=9.8

[input]
move_forward={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87),Object(InputEventKey,"physical_keycode":4194320)]}
move_back={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83),Object(InputEventKey,"physical_keycode":4194322)]}
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65),Object(InputEventKey,"physical_keycode":4194319)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68),Object(InputEventKey,"physical_keycode":4194321)]
interact={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69)]}
report={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":82)]}
flashlight={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":70)]}
journal={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":9)]}
sprint={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194325)]}
pause={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194305)]}
